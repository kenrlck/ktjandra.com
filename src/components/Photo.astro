---
/**
 * Single photo block for travel posts.
 * Sits centered in the column. Pass `wide` to break out a bit beyond the
 * 720px text column. Pass an optional caption for italic context.
 *
 * Usage in MDX:
 *   import dunes from './images/dunes.jpg';
 *   <Photo src={dunes} alt="Sand dunes at golden hour" caption="Erg Chebbi, sunrise." />
 *
 * `src` accepts either an imported local image (ImageMetadata) or a string URL.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
	wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
const isLocal = typeof src !== 'string';
---

<figure class:list={['photo', { 'photo--wide': wide }]}>
	{isLocal ? (
		<Image src={src as ImageMetadata} alt={alt} />
	) : (
		<img src={src as string} alt={alt} loading="lazy" />
	)}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

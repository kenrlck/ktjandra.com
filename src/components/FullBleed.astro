---
/**
 * Full-bleed photo for travel posts. Breaks past the 720px text column to
 * the viewport edges (or close to it on wide screens). Use sparingly —
 * one money shot per post.
 *
 * Usage in MDX:
 *   import hero from './images/hero.jpg';
 *   <FullBleed src={hero} alt="View from the ridge" caption="Day three, before the storm rolled in." />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
const isLocal = typeof src !== 'string';
---

<figure class="full-bleed">
	{isLocal ? (
		<Image src={src as ImageMetadata} alt={alt} />
	) : (
		<img src={src as string} alt={alt} loading="lazy" />
	)}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

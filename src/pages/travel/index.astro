---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostGrid from '../../components/PostGrid.astro';

const posts = (await getCollection('travel', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="en">
	<head>
		<BaseHead
			title="Travel · Kenrick Tjandra"
			description="Travel notes from places worth going back to. Slow, specific, and usually about food."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Travel</h1>
				<p class="lede">
					Notes from places worth going back to. Slow, specific, and usually about food.
				</p>
			</section>

			{posts.length > 0 ? (
				<PostGrid posts={posts} section="travel" />
			) : (
				<p class="empty-state">First posts arriving soon. Drafts in flight.</p>
			)}
		</main>
		<Footer />
	</body>
</html>

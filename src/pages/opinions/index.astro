---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('opinions', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="en">
	<head>
		<BaseHead
			title="Opinions · Kenrick Tjandra"
			description="Engineering takes, things I've changed my mind about, and the occasional rant."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Opinions</h1>
				<p class="lede">
					Engineering takes, things I've changed my mind about, and the occasional rant.
				</p>
			</section>

			{posts.length > 0 ? (
				<ul class="post-list">
					{posts.map((p) => (
						<li>
							<span class="post-date">
								<FormattedDate date={p.data.pubDate} />
							</span>
							<div>
								<div class="post-title">
									<a href={`/opinions/${p.id}`}>{p.data.title}</a>
								</div>
								<p class="post-desc">{p.data.description}</p>
							</div>
						</li>
					))}
				</ul>
			) : (
				<p class="empty-state">Building up to it.</p>
			)}
		</main>
		<Footer />
	</body>
</html>

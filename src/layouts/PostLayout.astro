---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	section?: 'work' | 'travel' | 'opinions';
	location?: string;
}

const SECTION_LABELS: Record<string, string> = {
	work: 'Work',
	travel: 'Travel',
	opinions: 'Opinions',
};

const { title, description, pubDate, updatedDate, heroImage, section, location } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · Kenrick Tjandra`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header>
					<p class="post-meta">
						{section && (
							<>
								<a href={`/${section}`}>{SECTION_LABELS[section]}</a>
								&nbsp;·&nbsp;
							</>
						)}
						<FormattedDate date={pubDate} />
						{location && (
							<>
								&nbsp;·&nbsp;
								{location}
							</>
						)}
					</p>
					<h1>{title}</h1>
					{description && <p class="lede">{description}</p>}
				</header>
				{heroImage && <Image src={heroImage} alt="" width={1200} height={675} />}
				<slot />
				{updatedDate && (
					<p style="margin-top: 3rem; color: var(--color-ink-faint); font-size: 0.85rem; font-family: var(--font-sans);">
						Last updated <FormattedDate date={updatedDate} />.
					</p>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

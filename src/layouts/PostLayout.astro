---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	heroImageUrl?: string;
	heroLayout?: 'standard' | 'split';
	section?: 'work' | 'travel' | 'opinions';
	location?: string;
}

const SECTION_LABELS: Record<string, string> = {
	work: 'Work',
	travel: 'Travel',
	opinions: 'Opinions',
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageUrl,
	heroLayout = 'standard',
	section,
	location,
} = Astro.props;

const useSplitHero = heroLayout === 'split' && (heroImage || heroImageUrl);
---

<html lang="en">
	<head>
		<BaseHead title={`${title} · Kenrick Tjandra`} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		{useSplitHero && (
			<section class="hero-split" aria-label="Article header">
				<div class="hero-split__text">
					<p class="post-meta">
						{section && (
							<>
								<a href={`/${section}`}>{SECTION_LABELS[section]}</a>
								&nbsp;·&nbsp;
							</>
						)}
						<FormattedDate date={pubDate} />
						{location && (
							<>
								&nbsp;·&nbsp;
								{location}
							</>
						)}
					</p>
					<h1>{title}</h1>
					{description && <p class="lede">{description}</p>}
				</div>
				<div class="hero-split__image">
					{heroImage ? (
						<Image src={heroImage} alt="" width={1600} height={2000} />
					) : (
						<img src={heroImageUrl} alt="" />
					)}
				</div>
			</section>
		)}
		<main>
			<article>
				{!useSplitHero && (
					<>
						<header>
							<p class="post-meta">
								{section && (
									<>
										<a href={`/${section}`}>{SECTION_LABELS[section]}</a>
										&nbsp;·&nbsp;
									</>
								)}
								<FormattedDate date={pubDate} />
								{location && (
									<>
										&nbsp;·&nbsp;
										{location}
									</>
								)}
							</p>
							<h1>{title}</h1>
							{description && <p class="lede">{description}</p>}
						</header>
						{heroImage && <Image src={heroImage} alt="" width={1200} height={675} />}
					</>
				)}
				<slot />
				{updatedDate && (
					<p style="margin-top: 3rem; color: var(--color-ink-faint); font-size: 0.85rem; font-family: var(--font-sans);">
						Last updated <FormattedDate date={updatedDate} />.
					</p>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
